{"nodes": [{"id": "game_save_core_save_reading_standard", "label": "Save-reading standard", "file_type": "document", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_save_reading_standard_content_led_reads", "label": "Content-led reads", "file_type": "rationale", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reader calibrated on one snapshot rejected a valid save after normal play, so support is decided by structure and probing rather than file name, folder or measured size."}, {"id": "game_save_core_save_reading_standard_container_families", "label": "Container-family acceptance", "file_type": "rationale", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw, header-prefixed, footer-annotated and combined wrappers are all accepted because the game and its emulators produce each of them; unverified assumptions stay bounded to exact sizes and the unwrapped window must still pass full structural validation."}, {"id": "game_save_core_save_reading_standard_structure_vs_gameplay_state", "label": "Structure versus gameplay-state tolerance", "file_type": "rationale", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard failure is reserved for files with no recognizable structure, because anomalous but recognizable content (new species ids, higher level caps, dangling references) must surface as review issues instead of rejecting the whole file."}, {"id": "game_save_core_save_reading_standard_write_safety_independence", "label": "Write safety independent of read tolerance", "file_type": "rationale", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tolerance in reads must never loosen writes: every write path re-derives its own observations from exact source bytes under a content revision, verifies the bytes it edits and blocks records with review issues."}, {"id": "game_save_core_save_reading_standard_revision_binding", "label": "contentRevision revision binding", "file_type": "concept", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "contentRevision hashes the exact source-container bytes including any wrapper, because that is what the user actually keeps on disk."}, {"id": "game_save_core_save_reading_standard_discovery_policy", "label": "Content-first save discovery policy", "file_type": "concept", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extension matching only widens discovery when the folder entry reports no size, so renamed saves are still found and a wrong size never decides support by itself."}, {"id": "game_save_core_save_reading_standard_registration_order", "label": "Reader registration order contract", "file_type": "concept", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Broad readers register first and specific readers last so that when nothing decodes, the most specific failure reason is the one shown to the user."}, {"id": "game_save_core_save_reading_standard_granular_error_reasons", "label": "Granular SaveReadFailure reasons", "file_type": "concept", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_save_reading_standard_new_reader_checklist", "label": "New-reader checklist", "file_type": "concept", "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "game_save_core_save_reading_standard", "target": "game_save_core_save_reading_standard_content_led_reads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_save_reading_standard", "target": "game_save_core_save_reading_standard_container_families", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_save_reading_standard", "target": "game_save_core_save_reading_standard_structure_vs_gameplay_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_save_reading_standard", "target": "game_save_core_save_reading_standard_write_safety_independence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_save_reading_standard", "target": "game_save_core_save_reading_standard_revision_binding", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/SAVE_READING_STANDARD.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_save_reading_standard", "target": "game_save_core_save_reading_sta