abel": "NdsStoryRecordCodec", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_ndsstoryconversionpolicies", "label": "NdsStoryConversionPolicies", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_worlddssavereader", "label": "WorldDsSaveReader", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recognition is grounded in the matching decompilation (per-save random lastId base, game bookkeeping cross-references) instead of single-snapshot header or value shapes, because two successive shape-based gates each rejected the user's real progressing save."}, {"id": "docs_testing_historical_regression_log_worlddspartyedits", "label": "WorldDsPartyEdits", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writes the same logical edit to every populated copy and refuses divergence, because the user's real card has two populated copies and the old any-multi-copy COPY_AUTHORITY refusals blocked every real move."}, {"id": "docs_testing_historical_regression_log_worlddsmoverecordpolicy", "label": "WorldDsMoveRecordPolicy", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_worlddssendpolicy", "label": "WorldDsSendPolicy", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_experimentalworlddsmovereepository", "label": "ExperimentalWorldDsMoveRepository", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_experimentalworlddssendrepository", "label": "ExperimentalWorldDsSendRepository", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_experimentaleditjournal", "label": "ExperimentalEditJournal", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_gameendpointpresence", "label": "GameEndpointPresence", "file_type": "concept", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only a completed, readback-verified send records presence, and copies of a save in other locations never mark presence, so an individual cannot disappear from Storage without a verified destination."}, {"id": "docs_testing_historical_regression_log_nativematerializationrepository", "label": "NativeMaterializationRepository", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_nativecanonicalmapping", "label": "NativeCanonicalMapping", "file_type": "concept", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records the native species ID, canonical target, USER_CONFIRMED authority and review time for one exact snapshot; it is a local reviewed reference, not a verified title-wide numeric crosswalk, and names/nicknames are never accepted as canonical IDs."}, {"id": "docs_testing_historical_regression_log_gameimportacquisitionrepository", "label": "GameImportAcquisitionRepository", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_snapshotimportplanner", "label": "SnapshotImportPlanner", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_nativegamesnapshot", "label": "NativeGameSnapshot", "file_type": "concept", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_nativemappingcontinuity", "label": "NativeMappingContinuity", "file_type": "code", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_testing_historical_regression_log_worlddsspeciestable", "label": "WorldDsSpeciesTable", "file_type": "concept", "source_file": "docs/testing/HISTORICAL_REGRESSION_LOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships the USA ROM's 426-entry species name table (with ROM SHA1,