{"nodes": [{"id": "ar_battle_implementation_ar_battle", "label": "AR Battle Mode", "file_type": "document", "source_file": "AR_BATTLE_IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ar_battle_implementation_ar_battles_enabled_flag", "label": "BuildConfig.AR_BATTLES_ENABLED Gate", "file_type": "rationale", "source_file": "AR_BATTLE_IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AR is developer-only because ARCore is an optional dependency and on-device acceptance was incomplete; release builds hide the preference and force the AR flow off so production users cannot start an AR battle."}, {"id": "ar_battle_implementation_hands_free_scanner", "label": "Hands-Free AR Placement Scanner", "file_type": "concept", "source_file": "AR_BATTLE_IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requiring nothing to tap keeps AR usable one-handed; layered quality gates trade a little latency for never launching a badly placed fight."}, {"id": "ar_battle_implementation_scale_plans", "label": "AR Scale Plans (Auto, Tabletop, Room, Open Space)", "file_type": "concept", "source_file": "AR_BATTLE_IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ar_battle_implementation_placement_frame", "label": "AR Placement Frame", "file_type": "concept", "source_file": "AR_BATTLE_IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ar_battle_implementation_arcore_session", "label": "ARCore Session Controller", "file_type": "concept", "source_file": "AR_BATTLE_IMPLEMENTATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"i