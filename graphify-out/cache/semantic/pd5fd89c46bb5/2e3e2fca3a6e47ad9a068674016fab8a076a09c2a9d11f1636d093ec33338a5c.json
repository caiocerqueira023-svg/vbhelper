{"nodes": [{"id": "game_save_core_world_ds_research_document", "label": "Digimon World DS: Phone Reading and Structural Research", "file_type": "document", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds the pinned structural evidence and offsets that the World DS reader, party editor and copy-integrity guard are built from; the historical signature-based research boundary is retained but explicitly superseded."}, {"id": "game_save_core_world_ds_research_worlddssavereader", "label": "WorldDsSaveReader (phone raw profile)", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unwraps raw, bare 0x7DC0, DSV-footer and wrapper-slack containers with content deciding, because a gameplay-magnitude or header-shape gate must never reject an otherwise self-consistent save."}, {"id": "game_save_core_world_ds_research_worlddsresearchinspector", "label": "WorldDsResearchInspector", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately standalone and not registered in SaveReaderRegistry or automatic discovery: it reports every DSDIGI candidate separately and never selects the newest or authoritative block."}, {"id": "game_save_core_world_ds_research_worlddspartyedits", "label": "WorldDsPartyEdits Structural Removal and Return", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds an in-memory structural candidate that retains all 384 original native bytes and requires every byte outside the selected slot and party table to stay identical, so a source removal is never replaced by a snapshot copy with a Move label."}, {"id": "game_save_core_world_ds_research_worlddscopyselection", "label": "WorldDsCopySelection", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Treats the unique newest valid +0x18 sequence as the copy the game intends to load, ignoring copies whose MD5 header does not match their own bytes; ties, missing counters and invalid headers stay unresolved rather than guessed."}, {"id": "game_save_core_world_ds_research_automaticsavereconciler", "label": "AutomaticSaveReconciler", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_world_ds_research_dsdigi_signature", "label": "DSDIGI Signature at +0x10", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written by writeSaveSignature on new-game initialization but absent on real progressing saves, so it is only one of several recognition facts and never the sole rule."}, {"id": "game_save_core_world_ds_research_card_copy_stride", "label": "Card Copy Stride 0x7E00", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "allocSaveBuffer rounds SAVE_SIZE 0x7DC0 up to the card's 0x100 page, so one copy occupies 0x7E00 and the second sits directly behind the first; a converted public save confirms the second copy at +0x7E00, not +0x8000."}, {"id": "game_save_core_world_ds_research_lastid_allocator", "label": "Local-ID Allocator (lastId at 0x208)", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "takeNextId starts from a per-save random 256-aligned base with the handout count in the low bytes, so absolute ID magnitude is not a plausibility signal; IDs are never 0, -1 or at/above ID_RESERVED 0xFFFFFF00."}, {"id": "game_save_core_world_ds_research_party_reference_array", "label": "Party Reference Array (0x20C)", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten 32-bit local record IDs, but only slots 0..7 are visible/ordinary (function searching and reserve reads prove it), so app insertion caps at eight and never writes slots 8/9."}, {"id": "game_save_core_world_ds_research_individual_record_layout", "label": "0x180-Byte Digimon Record Layout", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forty records at 0x234 with stride 0x180; name, stats, eight separate EXP counters, history and flags are kept as native units and never normalized into Time Stranger values."}, {"id": "game_save_core_world_ds_research_copy_integrity_header", "label": "Copy Integrity Header (MD5 reseal)", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The guard is MD5 over the copy's 0x7DC0 bytes with the header range itself zeroed; boot tests show the loader rejects a copy whose header lags its data, and the game's own writer recomputes nothing (it only bumps the sequence counter)."}, {"id": "game_save_core_world_ds_research_emulator_footer", "label": "Unified Emulator Footer (DeSmuME and DraStic)", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both emulators append the same 40-byte trailer (24 metadata + 16-byte cookie) and the padded-size field at footer+4 slices the payload, so one codec serves both; a malformed DSV stays INVALID_CONTAINER and never silently falls back to raw."}, {"id": "game_save_core_world_ds_research_glyph_codec", "label": "USA Name Glyph Codes", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uppercase maps 0x50-0x69, lowercase 0x6A-0x83, digits 1-10; these are game glyph codes, not UTF-16, so unmapped codes render as replacement characters while the exact original bytes are retained."}, {"id": "game_save_core_world_ds_research_species_name_tables", "label": "USA Species Name Tables (data_0211f4e0)", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A record's species id at +0x04 indexes the u32 offset table directly, so the game's own names identify species without inferring from display names; unresolvable entries (eggs, pods, missing spellings) stay unidentified and reviewable."}, {"id": "game_save_core_world_ds_research_extract_world_ds_species", "label": "extract_world_ds_species.py", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_world_ds_research_dwds_decomp", "label": "dwds_decomp (ReGame Labs, rev 91efd17)", "file_type": "document", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": "https://github.com/ReGame-Labs/dwds_decomp", "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned MIT decompilation providing the USA ADNE structure facts (SAVE_SIZE, allocSaveBuffer page rounding, takeNextId, Digimon struct, species tables); no decompiled source or game binaries are vendored."}, {"id": "game_save_core_world_ds_research_desmume_container", "label": "DeSmuME mc.cpp Container Reference", "file_type": "document", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": "https://github.com/TASEmulators/desmume/blob/06c64b02666a4ac5246aad95fc8e9ab9e69e5a53/desmume/src/mc.cpp", "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_world_ds_research_dsv_tool", "label": "albertowd dsv-tool (DSV_FOOTER_LENGTH = 24 + 16)", "file_type": "document", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": "https://github.com/albertowd/dsv-tool/blob/b669a8448f6ec192c0bf17c5268a8fa6aff6f5d3/app/plugins/dsv-tools.client.ts", "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_world_ds_research_sdb2txt", "label": "RigleGit SDB2TXT (sdb2txt.c)", "file_type": "document", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": "https://github.com/RigleGit/SDB2TXT/blob/29218eff19dbe39b07279cd5af5b02f79d3bc92d/sdb2txt.c", "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_world_ds_research_digimonndsromeditor", "label": "joaomlsantos DigimonNDSRomEditor (rev cc3ff49)", "file_type": "document", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": "https://github.com/joaomlsantos/DigimonNDSRomEditor", "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the Dawn/Dusk ROM-format baseline only: it edits ROM data rather than persisted individual saves, so its offsets must never be used as World DS save offsets."}, {"id": "game_save_core_world_ds_research_usa_drastic_raw_profile", "label": "Profile world-ds-usa-drastic-raw-v1", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_world_ds_research_provisional_party_acquisition", "label": "Provisional World DS Party Acquisition (schema 53)", "file_type": "concept", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permits provisional snapshot copies of eligible party records only: it is not a move, writer or verified global native-identity policy, and local IDs are matched inside the logical linked source rather than globally."}, {"id": "game_save_core_world_ds_research_preservingmigrationfactory", "label": "PreservingMigrationFactory", "file_type": "code", "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disables foreign-key cascades before the rebuild and restores enforcement on open, so schema 52 to 53 preserves native rows, child records, lifetime triggers and the autoincrement sequence."}], "edges": [{"source": "game_save_core_world_ds_research_worlddssavereader", "target": "game_save_core_world_ds_research_usa_drastic_raw_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_world_ds_research_worlddssavereader", "target": "game_save_core_world_ds_research_card_copy_stride", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/WORLD_DS_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source"