{"nodes": [{"id": "game_save_core_lost_evolution_research", "label": "Digimon Story Lost Evolution reverse-engineering notes", "file_type": "document", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_lost_evolution_research_lostevolution_profile", "label": "LostEvolution format profile and codecs", "file_type": "code", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The profile carries container size, slot count, integrity rule, record windows and glyph codec so the NDS Story registry never has to change for a new layout; edits reseal MD5, bump the sequence and verify readback with a byte-exact restore."}, {"id": "game_save_core_lost_evolution_research_custom_compression", "label": "Custom ROM compression scheme", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_lost_evolution_research_save_container", "label": "Lost Evolution 64 KiB two-slot EEPROM container", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two slots hold the same body except the sequence byte, and the MD5 header excludes itself, so the newest copy can be chosen structurally rather than by file time."}, {"id": "game_save_core_lost_evolution_research_save_buffer_mapping", "label": "Save offset equals 0x20 plus RAM offset mapping", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Save offset equals 0x20 plus the RAM offset because the roster array sits at RAM 0x1830 and save 0x1850, which anchors the record layout to the serialized player state."}, {"id": "game_save_core_lost_evolution_research_save_manager", "label": "ARM9 save-manager state machines", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_lost_evolution_research_roster_record_layout", "label": "0x78-byte roster record layout", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_lost_evolution_research_identity_references", "label": "Identity reference checklist for safe moves", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_lost_evolution_research_species_identity", "label": "Id-ordered species identity from MESPAK00", "file_type": "concept", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Index equals species id in the id-ordered MESPAK00 name run, validated against all five records, so species names resolve directly from the message pack without a separate crosswalk."}, {"id": "game_save_core_lost_evolution_research_le_species_table", "label": "LeSpeciesTable and le_species asset", "file_type": "code", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_lost_evolution_research_le_stat_conversion", "label": "LeStatConversion le-stat-v1 policy", "file_type": "code", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projects app stats into the engine record bands (HP 9999, combat 999, speed 99, level 99) and back, so synthesized records stay inside values the engine can actually hold."}, {"id": "game_save_core_lost_evolution_research_farm_records_movable", "label": "farmRecordsMovable farm transfer policy", "file_type": "rationale", "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Farm records are movable only for this layout because the editor clears the farm reference on removal, so the move policy opts in instead of assuming farm semantics."}], "edges": [{"source": "game_save_core_lost_evolution_research", "target": "game_save_core_lost_evolution_research_lostevolution_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_lost_evolution_research", "target": "game_save_core_lost_evolution_research_custom_compression", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_lost_evolution_research", "target": "game_save_core_lost_evolution_research_save_container", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/LOST_EVOLUTION_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_lost_evolution_research", "target": "game_save_core_lost_evolution_research_save_buffer_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sou