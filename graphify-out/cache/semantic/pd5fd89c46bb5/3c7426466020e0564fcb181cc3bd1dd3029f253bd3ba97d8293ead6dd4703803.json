{"nodes": [{"id": "game_save_core_format_research", "label": "Read-only Time Stranger Layout Profile", "file_type": "document", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_timestranger_container", "label": "Time Stranger AES-128-ECB container codec", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The AES-128-ECB key is a public game-format-wide constant, not a user Steam credential; the codec must re-encode decoded bytes byte-identically so the write rehearsal can prove a round trip while editing no fields."}, {"id": "game_save_core_format_research_strided_alignment_profile", "label": "Strided alignment format profile search", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Searches for a unique strided alignment rather than trusting fixed offsets, and keeps numeric species, stored name, personality and raw progression separate so a stored nickname is never promoted to an authoritative species mapping."}, {"id": "game_save_core_format_research_roster_structure", "label": "Roster active-prefix and inactive-tail structure", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active records occupy a contiguous prefix so flipping the stored flag on the first inactive bank record yields a roster the game itself would have written; reviving a mid-tail record would leave an inactive hole inside the active prefix."}, {"id": "game_save_core_format_research_inactive_tail_reactivation", "label": "Inactive-tail reactivation edit", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_forward_linked_list", "label": "Non-authoritative forward linked list", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The chain is mostly maintained but not authoritative (slot 0002 holds non-species pointer values), so the reader ignores that field and future writers must rebuild any chain they need instead of trusting it."}, {"id": "game_save_core_format_research_controlled_rename_evidence", "label": "Controlled rename before and after evidence", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_name_overwrite_semantics", "label": "Name overwrite with stale tail residue", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming overwrites from the name offset with new UTF-8 bytes plus one terminator and leaves the rest of the 32-byte window stale, so names resolve only up to the first terminator and a writer must mirror that residue behaviour."}, {"id": "game_save_core_format_research_corpus_validation", "label": "Seven-slot corpus validation", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_identity_evidence_comparison", "label": "IdentityEvidenceComparison possible-match guard", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A possible pair needs one nonzero candidate appearing exactly once in each observation on an active issue-free record, because a repeated value anywhere makes identity ambiguous; names, species, offsets and positions never substitute for candidate evidence."}, {"id": "game_save_core_format_research_snapshot_import_planner", "label": "SnapshotImportPlanner review boundary", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviews bind revision, profile, codec and planner so acquisition restrictions stay immutable, and species-mapping-pending is preserved separately so a confirmed-owned but unmapped individual can be archived inactive without guessing a canonical species."}, {"id": "game_save_core_format_research_native_refresh_review", "label": "Three-way native refresh review", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_universal_progress", "label": "UniversalProgress native progress model", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semantic fixed-point changes are kept separate from representation entry because an unchanged older representation must add no progress, and no-progress return must use the retained native record rather than an inverse of a lossy app projection."}, {"id": "game_save_core_format_research_destination_preview_planner", "label": "DestinationPreviewPlanner read-only evaluation", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "canExecute is always false because no writer or conversion policy is registered and capacity and DLC constraints are unvalidated, so evaluation can never be mistaken for execution or a lossless-return claim."}, {"id": "game_save_core_format_research_transfer_progress_context", "label": "TransferProgressContext app-side progress planning", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Units are never blended: recorded app changes stay RECORDED_CHANGES_UNMAPPED until a per-game adapter exists and a non-empty native queue is NATIVE_CHANGES_UNRESOLVED, so no status can imply executable transfer."}, {"id": "game_save_core_format_research_batch_planning", "label": "Batch destination planning", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_transfer_commit_journal", "label": "TransferCommit writer ladder journal", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A backup revision is mandatory before candidate readiness and RECOVERY_REQUIRED is allowed only before verification, because a destination that changed after this operation wrote it must be reconciled manually rather than blind-overwritten."}, {"id": "game_save_core_format_research_transfer_recovery", "label": "TransferRecovery commit recovery", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_write_rehearsal", "label": "Write-rehearsal pipeline CLI", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_format_research_rename_editor", "label": "TimeStranger rename writer", "file_type": "code", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name bytes come from a file so names never appear in command lines or logs, and the writer re-verifies its own candidate with outside-window byte equality plus a re-read name."}, {"id": "game_save_core_format_research_original_document_retention", "label": "Original-document chunked retention", "file_type": "concept", "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact source bytes are stored once in 64 KiB chunks with per-native-snapshot bindings to avoid oversized Room cursor rows, which preserves unknown original document content."}], "edges": [{"source": "game_save_core_format_research", "target": "game_save_core_format_research_timestranger_container", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_format_research", "target": "game_save_core_format_research_strided_alignment_profile", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/FORMAT_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_format_research", "target": "game_save_core_format_research_roster_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": 