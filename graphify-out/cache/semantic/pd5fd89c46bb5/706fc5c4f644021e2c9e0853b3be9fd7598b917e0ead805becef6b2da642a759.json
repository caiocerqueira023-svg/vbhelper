{"nodes": [{"id": "game_save_core_ds2_research", "label": "Digimon World Dawn and Dusk save layout", "file_type": "document", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_ds2_research_container", "label": "Dawn and Dusk two-copy MD5 container", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One adapter serves Dawn and Dusk because both titles persist the same layout, species table and EXP curves; the second copy region and the 0x54 zeroed gap expose the game own double-buffer scheme."}, {"id": "game_save_core_ds2_research_save_structure", "label": "Dawn and Dusk save structure and party references", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_ds2_research_individual_record", "label": "0x164-byte Dawn and Dusk individual record", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_ds2_research_free_party_slot_rule", "label": "Game free-party-slot assignment rule", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_ds2_research_species_text_data", "label": "Species base data and glyph text tables", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_ds2_research_exp_curves", "label": "Three 99-entry EXP curves", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "game_save_core_ds2_research_writer_rules", "label": "Ds2SaveEdits writer rules", "file_type": "code", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the copy whose sequence is the unique newest valid one is edited and a copy whose MD5 header does not match its bytes is refused, because the loader verifies exactly that header."}, {"id": "game_save_core_ds2_research_record_synthesis", "label": "Engine-mirroring record synthesis", "file_type": "concept", "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Synthesis mirrors the engine creation path and uses a retained record as the seed so native identity, unknown windows and existing history survive a projected rewrite."}], "edges": [{"source": "game_save_core_ds2_research", "target": "game_save_core_ds2_research_container", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_ds2_research", "target": "game_save_core_ds2_research_save_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_ds2_research", "target": "game_save_core_ds2_research_individual_record", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "game-save-core/DS2_RESEARCH.md", "source_location": null, "weight": 1.0}, {"source": "game_save_core_ds2_research", "target": "game_save_core_ds2_research_free_pa