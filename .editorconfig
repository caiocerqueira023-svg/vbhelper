root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Kotlin code style. Line length is not enforced by the build because the
# existing codebase was written before the current formatting baseline; the
# formatter/analyzer rollout is tracked in docs/refactor/PHASE7_DECISIONS.md.
[*.{kt,kts}]
max_line_length = off
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
